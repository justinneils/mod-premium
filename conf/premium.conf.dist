[worldserver]

################################################################################################################
#
#    PremiumAccount
#        Description: Enable PremiumAccount for players
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

PremiumAccount = 1

#    Morph
#        Description: Enable Morph & demorph option for players
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Morph = 1

#    Mount
#        Description: Allow Players to use mount
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Mount = 1

#    Class Trainers
#        Description: Allows players to spawn class trainers
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Trainers = 1

#    Profession Trainers
#        Description: Allows players to spawn profession trainers, choosing the
#                     proficiency tier (Journeyman .. Grand Master) per profession
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

ProfessionTrainers = 1

#    Trade Goods Vendors
#        Description: Allows players to summon trade-goods / profession supply vendors,
#                     choosing the profession (General, Alchemy, Blacksmithing, ...)
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

TradeGoodsVendors = 1

#    Ammunition Vendor
#        Description: Allows players to summon a vendor stocking every arrow and
#                     bullet that is sold by a vendor anywhere in the game -- 12 of
#                     each, Rough Arrow through Terrorshaft Arrow. Items keep their
#                     own RequiredLevel, so this sells nothing a character could not
#                     already buy; it just saves hunting down an ammo vendor after
#                     outgrowing each tier.
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

AmmoVendor = 1

#################################################################################################################
#    RefreshmentVendor
#        Description: Adds a "Food & Drink Vendor" option that summons a vendor
#                     stocking the whole food-and-drink ladder in one place: all 11
#                     ranks of mana-regen drink (Refreshing Spring Water through
#                     Honeymint Tea), the three rations that restore health and mana
#                     together (Enriched Manna Biscuit, Enriched Terocone Juice,
#                     Naaru Ration), and all 9 ranks of health-regen food. Items keep
#                     their own RequiredLevel, so this sells nothing a character could
#                     not already buy; it just saves hunting down a drink vendor after
#                     outgrowing each rank.
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

RefreshmentVendor = 1

#################################################################################################################
#    BagVendor
#        Description: Adds a "Bag Vendor" option that summons the game's own bag
#                     vendor for the player's faction -- Alyssa Griffith in Stormwind
#                     for Alliance, Gotri in Orgrimmar for Horde. Both carry the same
#                     four bags, Small Brown Pouch (6 slots) through Huge Brown Sack
#                     (12), priced in gold. Unlike the ammunition and food vendors
#                     this summons a real NPC rather than a custom one, because those
#                     two are the game's bag vendors and their stock needs no
#                     assembling. The 20-slot profession bags are NOT included: they
#                     are sold only by a handful of Outland vendors, and each one
#                     needs the matching profession to be worth carrying.
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

BagVendor = 1

#################################################################################################################
#    PlayerInteraction
#        Description: This enables the submenu for the below
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

PlayerInteraction = 1

#
#    Bank
#        Description: Allow Players to use mobile bank
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Bank = 1

#
#    Auction
#        Description: Allow Players to use mobile Auction
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Auction = 1

#    Vendor
#        Description: Allow Players to use vendor
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

Vendor = 1

#
#    Mail Box
#        Description: Allow Players Access ingame Mail
#        Default:     1  - (Enabled)
#                     0  - (Disabled)

MailBox = 1

##################################################################################################################
#   Premium.NpcDuration
#       Description: Time (in seconds) before despawn of summoned NPC
#       Default:    60 - (Seconds)

Premium.NpcDuration = 60
